{
  "name": "qa-portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:clean": "rm -rf cypress/reports cypress/screenshots cypress/videos",
    "test:e2e": "npm run test:clean && cypress run",
    "test:e2e:smoke": "cypress run --spec 'cypress/e2e/01-smoke-tests.cy.js'",
    "test:e2e:nav": "cypress run --spec 'cypress/e2e/02-navigation-tests.cy.js'",
    "test:e2e:theme": "cypress run --spec 'cypress/e2e/03-theme-toggle-tests.cy.js'",
    "test:e2e:links": "cypress run --spec 'cypress/e2e/04-links-tests.cy.js'",
    "test:e2e:responsive": "cypress run --spec 'cypress/e2e/05-responsive-tests.cy.js'",
    "test:e2e:content": "cypress run --spec 'cypress/e2e/06-content-validation-tests.cy.js'",
    "report:open": "start cypress/reports/html/index.html"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.7.1",
    "cypress-mochawesome-reporter": "^4.0.2",
    "postcss": "^8.4.47",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.13",
    "vite": "^7.2.4"
  }
}
